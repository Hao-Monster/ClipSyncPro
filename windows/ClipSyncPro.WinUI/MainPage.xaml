<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClipSyncPro_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClipSyncPro_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid
        Padding="18,14,18,14"
        Background="Transparent"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部搜索与全局动作 -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                Height="38"
                FontSize="15"
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="搜索剪贴历史、收藏、常用提示词或账户密码" />
            <Button
                Grid.Column="1"
                MinWidth="92"
                Click="RefreshButton_Click"
                Content="刷新" />
        </Grid>

        <!-- 顶部分段导航与常用操作栏 -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 核心视图分段导航胶囊 -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="NavAllButton" Click="NavAll_Click" Content="全部" Style="{ThemeResource AccentButtonStyle}" />
                <Button x:Name="NavFavoritesButton" Click="NavFavorites_Click" Content="⭐ 收藏夹" />
                <Button x:Name="NavPromptsButton" Click="NavPrompts_Click" Content="💡 提示词库" />
                <Button x:Name="NavSensitiveButton" Click="NavSensitive_Click" Content="🔒 账户密码" />
            </StackPanel>

            <!-- 右侧辅助工具栏 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="NewPromptButton" Click="NewPromptButton_Click" Content="+ 新建提示词" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}"/>
                <Button x:Name="DateFilterButton" Click="DateButton_Click" Content="按时间筛选" />
                <Button Click="BatchDeleteButton_Click" Content="批量删除" />
                <Button Click="CaptureButton_Click" Content="捕获当前" />
            </StackPanel>
        </Grid>

        <!-- 主内容区：剪贴板列表 与 提示词库列表双视图容器 -->
        <Grid Grid.Row="2">
            <!-- 视图 1：剪贴板历史 / 收藏 / 敏感列表 -->
            <ListView
                x:Name="RecordsList" Loaded="RecordsList_Loaded" PointerWheelChanged="RecordsList_PointerWheelChanged"
                ContainerContentChanging="RecordsList_ContainerContentChanging"
                Background="Transparent"
                BorderThickness="0"
                DoubleTapped="RecordsList_DoubleTapped"
                IsItemClickEnabled="True"
                KeyDown="RecordsList_KeyDown"
                Padding="0"
                SelectionChanged="RecordsList_SelectionChanged"
                SelectionMode="Single"
                Visibility="Visible">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="56" />
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>

                            <!-- 收藏星标切换按钮 -->
                            <Button
                                Width="34" Height="34"
                                Padding="0"
                                Margin="0,0,2,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="{Binding StarToolTip}"
                                Click="RecordStarButton_Click">
                                <FontIcon Glyph="{Binding IsFavoriteGlyph}" 
                                          Foreground="{Binding IsFavoriteBrush}" 
                                          FontSize="16" />
                            </Button>

                            <!-- 图片缩略图（若有） -->
                            <Image
                                Grid.Column="1"
                                Width="{Binding ImagePreviewWidth}"
                                Height="42"
                                Source="{Binding ImageUrl}"
                                Stretch="UniformToFill" />

                            <!-- 文本正文与元数据 -->
                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{Binding Summary}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding KindLabel}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SourcePlatform}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SyncStatus}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 右侧时间与快捷操作 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding DisplayTime}" />
                                <Button
                                    Width="30" Height="30"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="转为常用提示词"
                                    Click="RecordConvertToPrompt_Click">
                                    <FontIcon Glyph="&#xE735;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 视图 2：常用提示词库 (AI Prompt Library) -->
            <Grid x:Name="PromptsContainer" Visibility="Collapsed" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 提示词分类筛选胶囊 -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PromptCategoryPillPanel" Orientation="Horizontal" Spacing="8">
                        <Button Click="PromptCatAll_Click" Content="全部" Style="{ThemeResource AccentButtonStyle}"/>
                        <Button Click="PromptCatDev_Click" Content="代码开发" />
                        <Button Click="PromptCatTrans_Click" Content="翻译润色" />
                        <Button Click="PromptCatOffice_Click" Content="日常办公" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 提示词卡片列表 -->
                <ListView
                    x:Name="PromptsList"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    IsItemClickEnabled="True"
                    ItemClick="PromptsList_ItemClick"
                    DoubleTapped="PromptsList_DoubleTapped"
                    SelectionMode="Single"
                    Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="72" />
                            <Setter Property="Padding" Value="10,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2" Padding="14,10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 标题、分类、内容与插槽 -->
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Shortcut}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UsageSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 模板正文预览 -->
                                    <TextBlock Text="{Binding TemplateContent}" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <!-- 变量插槽提示 -->
                                    <TextBlock Text="{Binding VariablesSummary}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <!-- 右侧操作按钮组 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="调用" Click="ExecutePromptButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
                                    <Button ToolTipService.ToolTip="编辑" Click="EditPromptButton_Click">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="删除" Click="DeletePromptButton_Click">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- 底部状态指示 -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="正在连接本地 agent..." />
            <ProgressRing
                x:Name="BusyRing"
                Grid.Column="1"
                Width="18"
                Height="18"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
